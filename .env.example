################
## APPLICATION #
################
APP_NAME="Golang"
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en

########
## API #
########
ROUTE_API_PATH=api
ROUTE_API_VERSION=v1

########
## Cors #
########
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://cms-contact-form:8081,http://client-contact-form:8082
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_EXPOSE_HEADERS=Content-Length,Content-Type
CORS_MAX_AGE=24 # hours

#############
## DATABASE #
#############
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bodaq
DB_USERNAME=root
DB_PASSWORD=

